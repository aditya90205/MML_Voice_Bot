# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Public URL used in API responses (set to your ngrok / production host)
PUBLIC_BASE_URL=http://localhost:4000

# CORS — comma-separated origins, or * for local RN debugging
CORS_ORIGINS=*

# Protect admin/trigger APIs (send header: x-api-key)
API_KEY=change-me-to-a-long-random-secret

# Socket.IO
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000

# Call behaviour
CALL_RING_TIMEOUT_MS=45000
CALL_MAX_DURATION_MS=600000
CALL_IDLE_TIMEOUT_MS=90000

# Sarvam AI — https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_subscription_key

# Sarvam models / voice (Hindi)
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_CODEC=mp3

# Default AI persona for outbound AI calls (Hindi)
AI_SYSTEM_PROMPT=आप हमारे मोबाइल ऐप के सहायक हैं। हमेशा हिंदी में संक्षिप्त और स्वाभाविक जवाब दें (1-3 वाक्य)। उपयोगकर्ता के बोलने के बाद ही उत्तर दें। एक बार में एक ही सवाल पूछें और अगला जवाब उपयोगकर्ता के उत्तर के अनुसार दें।
AI_GREETING_TEXT=नमस्ते! मैं आपका AI सहायक हूँ। आज मैं आपकी कैसे मदद कर सकता हूँ?
